# Conservative static-asset headers. This file is parsed by Cloudflare Pages and is
# not served as an asset. HOST-03 keeps enforcing CSP and HSTS staged in comments
# only until a real provider/browser receipt and report review exist. The
# report-only policy is retained for one release while that evidence is gathered.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'

# Cloudflare documents these host patterns for keeping project and branch preview
# URLs out of search indexes. The custom domain remains the canonical target in
# index.html once the authorized host is established.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
