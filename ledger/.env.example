# Ledger Environment Configuration
# Copy this to .env and fill in values

# Database (SQLite default; can use postgresql://...)
DATABASE_URL=sqlite:///./data/benchmark_ledger.db

# Snapshot storage
SNAPSHOT_STORAGE_BACKEND=local
SNAPSHOT_LOCAL_ROOT=./data/snapshots

# HTTP client
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=benchmark-ledger/0.1

# Source credentials
# Current contained routes require and authorize no source credentials.
# Do not add source tokens here; credentialed source access remains blocked.

# Ingestion behavior
INGESTION_FAIL_FAST=false
