{
  "name": "ai-benchmark-aggregator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:portless": "portless run --name ai-benchmark-aggregator vite",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build && node ./scripts/build-provenance.mjs create",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck:test": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.test.json",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:mobile-overflow": "node ./scripts/test-mobile-overflow.mjs",
    "test:permalinks": "node ./scripts/test-permalinks.mjs",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "verify:official-artifact": "node ./scripts/verify-official-artifact.mjs && node --test ./scripts/verify-official-artifact-node-tests.mjs",
    "verify:build-provenance": "node ./scripts/build-provenance.mjs verify && node --test ./scripts/build-provenance-node-tests.mjs",
    "verify:pages-static": "node ./scripts/build-provenance.mjs verify && node ./scripts/verify-pages-static.mjs --require-dist && node --test ./scripts/verify-pages-static-node-tests.mjs",
    "verify:pages-workflows": "node ./scripts/verify-pages-workflows.mjs && node --test ./scripts/verify-pages-workflows-node-tests.mjs ./scripts/pages-smoke-url-node-tests.mjs ./scripts/smoke-pages-deployment-node-tests.mjs",
    "verify:bundle-budget": "node ./scripts/verify-bundle-budget.mjs --budget-total 1500000 --budget-eager 1100000 && node --test ./scripts/verify-bundle-budget-node-tests.mjs"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@radix-ui/react-toast": "^1.2.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.503.0",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "4.126.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "undici": "^7.29.0"
  }
}
