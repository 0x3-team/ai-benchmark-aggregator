{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Project Requirement",
  "type": "object",
  "required": [
    "requirement_id",
    "project_id",
    "type",
    "statement",
    "source_refs",
    "priority",
    "status",
    "acceptance_summary"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9-]+$"
    },
    "project_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "FUNCTIONAL",
        "NONFUNCTIONAL",
        "CONSTRAINT",
        "POLICY",
        "DECISION",
        "ASSUMPTION",
        "OUT_OF_SCOPE"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 10
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "enum": [
        "MUST",
        "SHOULD",
        "COULD",
        "WONT"
      ]
    },
    "status": {
      "enum": [
        "CONFIRMED",
        "INFERRED",
        "AMBIGUOUS",
        "CONFLICTING",
        "DEFERRED"
      ]
    },
    "acceptance_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "journey_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_strategy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_status": {
      "enum": [
        "UNCOVERED",
        "PARTIAL",
        "COVERED",
        "BLOCKED"
      ]
    }
  },
  "additionalProperties": false
}
