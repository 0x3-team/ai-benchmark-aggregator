{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Corpus Manifest",
  "type": "object",
  "required": ["schema_version", "project_id", "project_slug", "plan_version", "mode", "source_digests", "task_shards", "counts", "readiness", "audits"],
  "properties": {
    "schema_version": {"type": "string"},
    "project_id": {"type": "string"},
    "project_slug": {"type": "string"},
    "plan_version": {"type": "string"},
    "mode": {"enum": ["PRD_ONLY", "PRD_PLUS_REPO", "CORPUS_UPDATE"]},
    "source_digests": {"type": "object", "additionalProperties": {"type": "string"}},
    "task_shards": {"type": "array", "items": {"type": "string"}},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "readiness": {"enum": ["READY", "CONDITIONALLY_READY", "NOT_READY"]},
    "audits": {"type": "object", "additionalProperties": {"enum": ["PASS", "WARN", "FAIL", "NOT_RUN"]}},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
