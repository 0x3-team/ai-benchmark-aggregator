{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency Edge",
  "type": "object",
  "required": [
    "from_task_id",
    "to_task_id",
    "kind"
  ],
  "properties": {
    "from_task_id": {
      "type": "string"
    },
    "to_task_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "HARD",
        "SOFT",
        "PARENT_CHILD"
      ]
    },
    "artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
