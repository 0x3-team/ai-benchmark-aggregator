{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/task.schema.json",
  "title": "Software Orchestrator Planning Task",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "display_key",
    "project_id",
    "plan_version",
    "title",
    "objective",
    "rationale",
    "level",
    "dispatchable",
    "category",
    "hierarchy_path",
    "requirement_ids",
    "source_refs",
    "status",
    "priority",
    "risk",
    "size",
    "inputs",
    "expected_outputs",
    "in_scope",
    "out_of_scope",
    "hard_dependencies",
    "soft_dependencies",
    "acceptance_criteria",
    "verification_plan",
    "definition_of_ready",
    "definition_of_done",
    "capability_tags",
    "suggested_agent_role",
    "tools_required",
    "parallelization"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TSK-[A-Z0-9]{8,12}$"
    },
    "display_key": {
      "type": "string",
      "minLength": 3
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "replaced_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "level": {
      "enum": [
        "PROGRAM",
        "WORKSTREAM",
        "EPIC",
        "FEATURE",
        "LEAF",
        "BARRIER"
      ]
    },
    "dispatchable": {
      "type": "boolean"
    },
    "category": {
      "enum": [
        "DISCOVERY",
        "DECISION",
        "CONTRACT",
        "IMPLEMENTATION",
        "MIGRATION",
        "VERIFICATION",
        "SECURITY",
        "OBSERVABILITY",
        "DOCUMENTATION",
        "RELEASE",
        "CLEANUP",
        "GOVERNANCE"
      ]
    },
    "subtype": {
      "type": [
        "string",
        "null"
      ]
    },
    "hierarchy_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "workstream_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "component_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "derived_concern_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PLANNED",
        "PROVISIONAL",
        "BLOCKED",
        "READY",
        "RETIRED"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "size": {
      "enum": [
        "XS",
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "requires_repo_binding": {
      "type": "boolean",
      "default": false
    },
    "hard_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "soft_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "blocking_decision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "default": []
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "statement",
          "verification_type",
          "requirement_ids",
          "mandatory"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "verification_type": {
            "enum": [
              "TEST",
              "BUILD",
              "TYPECHECK",
              "LINT",
              "STATIC_ANALYSIS",
              "SECURITY_SCAN",
              "CONTRACT_CHECK",
              "SCHEMA_CHECK",
              "PERFORMANCE_CHECK",
              "ACCESSIBILITY_CHECK",
              "MANUAL_INSPECTION",
              "DOCUMENT_REVIEW",
              "METRIC_CHECK",
              "DEPLOYMENT_CHECK"
            ]
          },
          "verification_detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mandatory": {
            "type": "boolean"
          },
          "evidence_expected": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "verification_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "definition_of_ready": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "definition_of_done": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "capability_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "suggested_agent_role": {
      "type": "string",
      "minLength": 3
    },
    "tools_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "estimated_context_size": {
      "enum": [
        "SMALL",
        "MEDIUM",
        "LARGE",
        "UNKNOWN"
      ],
      "default": "UNKNOWN"
    },
    "parallelization": {
      "type": "object",
      "required": [
        "parallelizable",
        "execution_wave",
        "conflict_keys",
        "integration_surface"
      ],
      "properties": {
        "parallelizable": {
          "type": "boolean"
        },
        "execution_wave": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "conflict_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "integration_surface": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ancestor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "workstream": {
      "type": [
        "string",
        "null"
      ]
    },
    "epic": {
      "type": [
        "string",
        "null"
      ]
    },
    "feature": {
      "type": [
        "string",
        "null"
      ]
    },
    "subcategories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "derived_concern_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "complexity": {
      "enum": [
        "TRIVIAL",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "default": "MEDIUM"
    },
    "technology_stack": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "interface_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "data_entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "actor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "journey_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tool_restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "workspace_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "provisional_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "base_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "security_sensitivity": {
      "enum": [
        "NONE",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "default": "LOW"
    },
    "verification_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "verification_type",
          "description",
          "deterministic"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "verification_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_result": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "deterministic": {
            "type": "boolean"
          },
          "human_review_required": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dispatchable": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "const": "LEAF"
          },
          "size": {
            "enum": [
              "XS",
              "S",
              "M"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
