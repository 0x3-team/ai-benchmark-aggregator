{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Task",
  "type": "object",
  "required": [
    "task_id", "project_id", "title", "objective", "category",
    "complexity", "risk", "priority", "dependencies", "status",
    "acceptance_criteria", "read_scope", "write_scope"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string" },
    "parent_task_id": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "rationale": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "explore", "architecture", "backend", "frontend", "api", "data",
        "infra", "test", "docs", "refactor", "security", "migration",
        "integration", "release", "bugfix", "other"
      ]
    },
    "technology_stack": {
      "type": "array",
      "items": { "type": "string" }
    },
    "complexity": { "type": "string", "enum": ["trivial", "low", "medium", "high", "critical"] },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "requirement_ids": { "type": "array", "items": { "type": "string" } },
    "read_scope": { "type": "array", "items": { "type": "string" } },
    "write_scope": { "type": "array", "items": { "type": "string" } },
    "conflict_set": { "type": "array", "items": { "type": "string" } },
    "context_manifest": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "test_plan": { "type": "array", "items": { "type": "string" } },
    "expected_artifacts": { "type": "array", "items": { "type": "string" } },
    "output_schema": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "RECEIVED", "SCOPED", "PLANNED", "BLOCKED", "READY", "ROUTING",
        "DISPATCHED", "RUNNING", "REVIEW", "REVISION_REQUESTED", "APPROVED",
        "SELF_FIX", "TAKEOVER", "INTEGRATING", "INTEGRATED", "VERIFIED",
        "LEARNED", "FAILED", "CANCELLED"
      ]
    },
    "assigned_model": { "type": ["string", "null"] },
    "workspace": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "type": "string", "enum": ["worktree", "branch", "sandbox", "inline"] },
        "path": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "base_revision": { "type": ["string", "null"] },
    "retry_policy": {
      "type": "object",
      "properties": {
        "max_retries": { "type": "integer", "minimum": 0, "default": 1 },
        "strategy": { "type": "string", "enum": ["same_agent", "takeover", "re_route"] }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_cost_usd": { "type": "number" },
        "max_latency_ms": { "type": "integer" },
        "max_tokens": { "type": "integer" }
      }
    },
    "timestamps": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
