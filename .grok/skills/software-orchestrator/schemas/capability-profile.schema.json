{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-profile.schema.json",
  "title": "CapabilityProfile",
  "type": "object",
  "required": ["model_id", "provider", "version", "harness", "category"],
  "properties": {
    "model_id": { "type": "string" },
    "provider": { "type": "string" },
    "version": { "type": "string" },
    "harness": { "type": "string" },
    "reasoning_setting": { "type": ["string", "null"] },
    "category": { "type": "string" },
    "technology_stack": { "type": "array", "items": { "type": "string" } },
    "sample_count": { "type": "integer" },
    "effective_sample_weight": { "type": "number" },
    "success_alpha": { "type": "number", "description": "Beta posterior alpha" },
    "success_beta": { "type": "number", "description": "Beta posterior beta" },
    "pass_at_first_attempt_rate": { "type": "number" },
    "eventual_success_rate": { "type": "number" },
    "retry_rate": { "type": "number" },
    "takeover_rate": { "type": "number" },
    "mean_review_score": { "type": "number" },
    "review_score_variance": { "type": "number" },
    "integration_defect_rate": { "type": "number" },
    "rollback_rate": { "type": "number" },
    "latency_ewma_ms": { "type": "number" },
    "cost_ewma_usd": { "type": "number" },
    "token_ewma": { "type": "number" },
    "reliability": { "type": "number" },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "weaknesses": { "type": "array", "items": { "type": "string" } },
    "failure_mode_counts": { "type": "object" },
    "last_success_at": { "type": ["string", "null"] },
    "last_fail_at": { "type": ["string", "null"] },
    "recency_half_life_days": { "type": "number", "default": 21 },
    "confidence_low": { "type": "number" },
    "confidence_high": { "type": "number" },
    "drift_status": { "type": "string", "enum": ["stable", "watch", "drift", "unknown"] },
    "supporting_event_ids": { "type": "array", "items": { "type": "string" } },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
