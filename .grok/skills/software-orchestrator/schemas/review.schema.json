{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "ReviewRecord",
  "type": "object",
  "required": ["task_id", "attempt_id", "reviewer", "verdict", "selected_action"],
  "properties": {
    "task_id": { "type": "string" },
    "attempt_id": { "type": "string" },
    "reviewer": { "type": "string", "const": "grok-orchestrator" },
    "verdict": { "type": "string", "enum": ["pass", "pass_with_nits", "fail"] },
    "requirement_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": { "type": "string" },
          "covered": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "correctness": { "type": "number", "minimum": 0, "maximum": 1 },
        "tests": { "type": "number", "minimum": 0, "maximum": 1 },
        "security": { "type": "number", "minimum": 0, "maximum": 1 },
        "architecture": { "type": "number", "minimum": 0, "maximum": 1 },
        "maintainability": { "type": "number", "minimum": 0, "maximum": 1 },
        "integration": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "critical_issues": { "type": "array", "items": { "type": "string" } },
    "major_issues": { "type": "array", "items": { "type": "string" } },
    "minor_issues": { "type": "array", "items": { "type": "string" } },
    "required_changes": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "selected_action": {
      "type": "string",
      "enum": [
        "APPROVE_AND_INTEGRATE",
        "SELF_FIX_AND_INTEGRATE",
        "RETRY_SAME_AGENT",
        "TAKE_OVER",
        "BLOCK_FOR_HUMAN"
      ]
    }
  }
}
