              "engineName": {
                "const": "postgresql"
              },
              "engineVersion": {
                "pattern": "^16\\.\\d+(?:\\.\\d+)?$"
              },
              "format": {
                "const": "postgresql_custom_archive"
              },
              "formatVersion": {
                "const": "pg_dump-custom-v1"
              },
              "inspectionEngineVersion": {
                "pattern": "^16\\.\\d+(?:\\.\\d+)?$"
              },
              "inspectionToolVersion": {
                "pattern": "^16\\.\\d+(?:\\.\\d+)?$"
              },
              "integrity": {
                "$ref": "#/$defs/postgresqlIntegrity"
              },
              "schemaDigestAlgorithm": {
                "const": "sha256-canonical-postgresql-schema-v1"
