            "required": [
              "environment",
              "lane",
              "cycleId",
              "scheduledFor",
              "schedulePolicyRevisionId",
              "contentSha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "watermarks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "completedCycleCount": {
                "minimum": 1,
                "type": "integer"
              },
              "cycleSetSha256": {
                "$ref": "#/$defs/sha256"
              },
              "earliestCycleId": {
                "$ref": "#/$defs/stableId"
              },
              "earliestScheduledFor": {
                "$ref": "#/$defs/utcTimestamp"
              },
              "environment": {
                "$ref": "#/$defs/stableId"
              },
              "lane": {
                "enum": [
                  "discovery",
                  "recheck",
                  "maintenance"
                ]
              },
              "latestCycleContentSha256": {
                "$ref": "#/$defs/sha256"
              },
              "latestCycleId": {
                "$ref": "#/$defs/stableId"
              },
              "latestScheduledFor": {
                "$ref": "#/$defs/utcTimestamp"
              }
