              "earliestCycleId",
              "latestScheduledFor",
              "latestCycleId",
              "latestCycleContentSha256",
              "cycleSetSha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "completedCycleCount",
        "cycleSetSha256",
        "cycles",
        "watermarks"
      ],
      "type": "object"
    },
    "failureDomains": {
      "additionalProperties": false,
      "properties": {
        "declaredDistinct": {
          "const": true
        },
        "independenceEvidence": {
          "const": "external_evidence_required"
        },
        "recovery": {
          "$ref": "#/$defs/stableId"
        },
        "source": {
          "$ref": "#/$defs/stableId"
        }
      },
      "required": [
        "source",
        "recovery",
        "declaredDistinct",
        "independenceEvidence"
      ],
      "type": "object"
    },
    "manifest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256-canonical-recovery-json-v1"
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "objectReferenceCount": {
          "$ref": "#/$defs/count"
        },
        "tableCount": {
          "const": 36
        }
      },
      "required": [
        "algorithm",
        "contentSha256",
        "tableCount",
        "objectReferenceCount"
      ],
      "type": "object"
    },
    "mode": {
      "enum": [
        "synthetic_fixture",
        "shadow",
