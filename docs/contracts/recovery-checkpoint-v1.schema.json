    },
    "recoveryObjective": {
      "additionalProperties": false,
      "properties": {
        "maximumCompletedCyclesLost": {
          "const": 1
        },
        "productionClaim": {
          "const": false
        },
        "status": {
          "const": "target_only_unproven"
        }
      },
      "required": [
